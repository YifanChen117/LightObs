ARG GO_IMAGE=golang:1.22
ARG RUNTIME_IMAGE=debian:bookworm-slim
FROM ${GO_IMAGE} AS build
ARG GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct
ARG GOSUMDB=off
ENV GOPROXY=${GOPROXY}
ENV GOSUMDB=${GOSUMDB}
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 go build -o /out/lightobs-agent ./cmd/agent

FROM ${RUNTIME_IMAGE}
WORKDIR /
COPY --from=build /out/lightobs-agent /lightobs-agent
ENTRYPOINT ["/lightobs-agent"]
